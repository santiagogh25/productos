<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../secciones/head'); %>
</head>
<body class="d-flex flex-column min-vh-100">
    <main>
        <div class="container">
            <%- include('../secciones/menu'); %>
            <h1>Modificar producto</h1>

            <div class="row mt-5">
                <div class="col-2"></div>
                <div class="col-8">
                    <form action="/productos/modificarProducto" method="post">
                        <% producto.forEach((producto) => { %>
                            <div class="card">
                                <div class="card-header">
                                    <h2>Modificar producto</h2>
                                </div>
                                <div class="card-body">
                                    <input type="text" class="form-control"
                                        readonly name="idProducto" id="idProducto"
                                        value="<%= producto.idProducto %>" />
                                    <br />
                                    <input type="text" class="form-control"
                                        name="nombreProducto" id="nombreProducto"
                                        value="<%= producto.nombreProducto %>"
                                        placeholder="Nombre del producto" required />
                                    <br />
                                    <input type="text" class="form-control"
                                        name="marcaProducto" id="marcaProducto"
                                        value="<%= producto.marcaProducto %>"
                                        placeholder="Marca del producto" required />
                                    <br />
                                    <input type="number" step="0.01" min="0" class="form-control"
                                        name="precioProducto" id="precioProducto"
                                        value="<%= producto.precioProducto %>"
                                        placeholder="Precio del producto" required />
                                </div>
                                <div class="card-footer">
                                    <a class="btn btn-secondary" href="/productos/listarProductos">Cancelar</a>
                                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                                </div>
                            </div>
                        <% }); %>
                    </form>
                </div>
                <div class="col-2"></div>
            </div>
        </div>
    </main>
    <footer class="footer mt-auto py-3 bg-light">
        <%- include('../secciones/footer'); %>
    </footer>
</body>
</html>